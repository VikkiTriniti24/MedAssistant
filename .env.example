# General
FLASK_ENV=development
SECRET_KEY=change-me-dev-only
JWT_SECRET_KEY=change-me-dev-only

# Database
DATABASE_URL=sqlite:///instance/health_app.db

# JWT / Cookies
JWT_ACCESS_TOKEN_EXPIRES=1800
JWT_REFRESH_TOKEN_EXPIRES=604800
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=false

# Email (optional)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@medassistant.local
EMAIL_VERIFICATION_URL=http://localhost:5000/auth/verify
EMAIL_VERIFICATION_TOKEN_MINUTES=60

# AI / Integrations
AI_STUB=1
# OPENAI_API_KEY=sk-...
